{
  "manifest_version": 3,
  "name": "TokenVeil",
  "version": "1.0.1",
  "description": "A native-feeling Claude.ai overlay showing tokens, context, cache timer, and usage — blends seamlessly into the UI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/modules/tokenCounter.js",
        "src/modules/usageTracker.js",
        "src/modules/modelDetector.js",
        "src/modules/cacheTimer.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://claude.ai/*"]
}
